# Biblioteca: se sirven imágenes y documentos, pero nunca se ejecuta código
<FilesMatch "\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
